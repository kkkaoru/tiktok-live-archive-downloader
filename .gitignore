/.claude/skills

# Machine-local/editor scratch files
.DS_Store
.tmp*
.idea/
.vscode/

# Private generated transcript summaries, including immutable prior revisions
*.summaries/

# Swift TranscriptViewer build outputs (regenerated by TranscriptViewer/build-app.sh)
/TranscriptViewer/.build/
/TranscriptViewer/App/AppIcon.icns

# Shared native sources are public; generated SwiftPM state is not.
/native/apple-pro-apps/.build/
/native/apple-pro-apps/.swiftpm/
